      },
      {
        "namespace": "minecraft",
        "path": "recipe/.*cut_copper.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/.*cut_copper.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/(?!.*waxed_copper_block_from_honeycomb\\.json)(?!.*waxed_exposed_copper_from_honeycomb\\.json)(?!.*waxed_weathered_copper_from_honeycomb\\.json)(?!.*waxed_oxidized_copper_from_honeycomb\\.json)(?!.*_bulb_from_honeycomb\\.json).*waxed.*_from_honeycomb\\.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/(?!.*waxed_copper_block_from_honeycomb\\.json)(?!.*waxed_exposed_copper_from_honeycomb\\.json)(?!.*waxed_weathered_copper_from_honeycomb\\.json)(?!.*waxed_oxidized_copper_from_honeycomb\\.json)(?!.*_bulb_from_honeycomb\\.json).*waxed.*_from_honeycomb\\.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/.*_stairs_from.*stonecutting\\.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/.*_stairs_from.*stonecutting\\.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/.*_slab_from.*stonecutting\\.json"
