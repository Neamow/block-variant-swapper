{
  "pack": {
    "pack_format": 48,
    "description": "Block Variant Swapper: removes vanilla recipes for swappable block variants"
  },
  "filter": {
    "block": [
      {
        "namespace": "minecraft",
        "path": "recipe/.*_stairs.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/.*_stairs.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/.*_slab.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/.*_slab.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/.*_wall.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/.*_wall.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/.*_fence.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/.*_fence.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/.*_fence_gate.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/.*_fence_gate.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/(?!.*iron_door\\.json).*_door.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/(?!.*iron_door\\.json).*_door.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/(?!.*iron_trapdoor\\.json).*_trapdoor.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/(?!.*iron_trapdoor\\.json).*_trapdoor.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/(?!.*heavy_weighted_pressure_plate\\.json)(?!.*light_weighted_pressure_plate\\.json).*_pressure_plate.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/(?!.*heavy_weighted_pressure_plate\\.json)(?!.*light_weighted_pressure_plate\\.json).*_pressure_plate.json"
      },
      {
        "namespace": "minecraft",
        "path": "recipe/.*_button.json"
      },
      {
        "namespace": "minecraft",
        "path": "advancement/recipes/.*_button.json"
      },
      {
