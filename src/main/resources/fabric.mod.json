{
	"schemaVersion": 1,
	"id": "blockvariantswapper",
	"version": "${version}",
	"name": "Block Variant Swapper",
	"description": "Swap block variants, such as stairs, slabs or doors, on the fly.",
	"authors": [
		"Neamow"
	],
	"contact": {
		"homepage": "https://github.com/Neamow/block-variant-swapper",
		"sources": "https://github.com/Neamow/block-variant-swapper"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/blockvariantswapper/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.neamow.blockvariantswapper.BlockVariantSwapper"
		],
		"client": [
			"net.neamow.blockvariantswapper.BlockVariantSwapperClient"
		],
		"jei_mod_plugin": [
			"net.neamow.blockvariantswapper.compat.jei.BlockVariantSwapperJeiPlugin"
		]
	},
	"mixins": [
		"blockvariantswapper.mixins.json",
		{
			"config": "blockvariantswapper.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
